# Исходные CSV скачиваются через bash scripts/download_data.sh.
# Не игнорируем *.csv глобально: отчёты проверок в docs/ входят в проект.
/data/

# Локальные секреты и переменные окружения. Шаблоны можно коммитить.
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Виртуальные окружения Python и кэш интерпретатора / инструментов.
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Персональные настройки IDE и SQL-клиента.
.idea/
.vscode/
.dbeaver/
.dbeaver-data-sources*.xml

# Локальные логи, временные файлы и резервные копии редакторов.
*.log
*.tmp
*.swp
*.swo
*~
/tmp/
/backups/

# Дампы БД не храним в Git. SQL модели в model/ остаётся отслеживаемым.
*.dump
*.backup

# Служебные файлы macOS и Windows.
.DS_Store
._*
Thumbs.db
Desktop.ini
