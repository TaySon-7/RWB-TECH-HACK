# Fill these three values for an OpenAI-compatible model supporting tool calls.
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
# false: Chat Completions. Use true only if your endpoint supports Responses API.
LLM_USE_RESPONSES_API=false
LLM_REASONING_EFFORT=none
LLM_TIMEOUT_SECONDS=90
LLM_MAX_OUTPUT_TOKENS=6000

# Local CLI/API. The analytics compose overrides this with clickhouse.
AGENT_DB_BACKEND=postgres
DATABASE_URL=postgresql://hack:hack@localhost:5433/marketplace
SQL_AGENT_MAX_REPAIRS=2
SQL_AGENT_MAX_TOOL_CALLS=12
SQL_AGENT_MAX_ROWS=200
SQL_AGENT_TIMEOUT_MS=15000
AGENT_RUNTIME_DIR=sql_agent/artifacts
